{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "public/**",
    "bun.lock",
    "src/routeTree.gen.ts",
    ".cta.json",
    ".output/**",
    ".tanstack/**",
    "playwright-report/**",
    "test-results/**"
  ]
}
