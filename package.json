{
  "name": "spicey-portfolio",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "bun run validate:stories && vite build",
    "preview": "vite preview",
    "start": "bun .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "story": "bun scripts/new-story.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "validate:stories": "bun scripts/validate-stories.ts",
    "lint": "oxlint --max-warnings 0 .",
    "lint:fix": "oxlint --fix --max-warnings 0 .",
    "test:e2e": "playwright test",
    "db:backup": "bun scripts/backup-database.ts"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.7.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "lucide-react": "^1.52.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.32.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "seroval": "1.6.8",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ]
}
