# Browser-visible PostHog configuration.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=<ph_project_token>
VITE_PUBLIC_POSTHOG_HOST=<ph_client_api_host>

# Server-only. Never prefix these with VITE_.
RESEND_API_KEY=
# Use a verified sending domain in production.
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Optional: retain stories served by the old blog service.
WRITE_IT_UP_URL=

# Clerk publishable keys are intentionally public; the secret stays server-only.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user IDs. Empty means nobody can administer the site.
CMS_ADMIN_USER_IDS=
# Optional local SQLite database; ignored when TURSO_DATABASE_URL is set.
DATABASE_PATH=./data/portfolio.sqlite
# Set both on Vercel using the Turso database URL and auth token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Connect the approved public Vercel Blob store to Production in Vercel.
# The integration injects its server-only access configuration automatically.
# Never expose a Blob write token to the browser or commit an actual value.
BLOB_READ_WRITE_TOKEN=

# Build-only PostHog source-map upload key. Set as Secret in Vercel Production
# only; Adam enters it directly in Vercel. Never use a VITE_ prefix or commit it.
POSTHOG_API_KEY=

# Contact form Turnstile widget. Public site key: Config, Production only.
VITE_TURNSTILE_SITE_KEY=
# Private widget secret: Secret, Production only. Enter directly in Vercel.
TURNSTILE_SECRET_KEY=
