# Server-only. Never prefix these with VITE_.
RESEND_API_KEY=
# Use a verified sending domain in production.
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Optional: retain stories served by the old blog service.
WRITE_IT_UP_URL=

# Clerk publishable keys are intentionally public; the secret stays server-only.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user IDs. Empty means nobody can administer the site.
CMS_ADMIN_USER_IDS=
# Mount this directory persistently in production. Never put it in public/.
DATABASE_PATH=./data/portfolio.sqlite
